# Environment Configuration
# Copy this file to .env and configure the values

# Server
PORT=3000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=change_this_to_a_secure_random_secret
JWT_EXPIRES_IN=24h

# Admin user (created on first startup if no users exist)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Paths
CONFIG_FILE_PATH=./config/microservice.config.json
UPLOADS_DIR=./uploads
